---
import '../styles/global.css'
import 'lenis/dist/lenis.css'

interface Props {
	/**
	 * No need to include " | Leighton Guang" at the end, it will be added automatically.
	 */
	title?: string

	/**
	 * The description of the page
	 */
	description?: string
}

const { title = 'Leighton Guang', description = '' } = Astro.props
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />

		<link id="favicon" rel="icon" type="image/svg+xml" href="/favicon-light.svg" />

		<meta name="generator" content={Astro.generator} />
		<title>{title === 'Leighton Guang' ? title : `${title} | Leighton Guang`}</title>
		<meta name="description" content={description} />

		<script is:inline>
			const getTheme = () => {
				return localStorage.getItem('theme') ?? 'light'
			}

			const setFavicon = () => {
				const favicon = document.querySelector('#favicon')

				if (!favicon) return

				const isDark = document.documentElement.classList.contains('dark')

				favicon.href = isDark ? '/favicon-dark.svg' : '/favicon-light.svg'
			}

			const theme = getTheme()

			document.documentElement.classList.toggle('dark', theme === 'dark')

			setFavicon()

			const observer = new MutationObserver(setFavicon)

			observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['class']
			})
		</script>
	</head>

	<body>
		<main class="relative min-h-screen">
			<slot />
		</main>
	</body>
</html>
