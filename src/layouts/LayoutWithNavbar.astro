---
import RootLayout from './RootLayout.astro'
import { Navbar } from '../components/Navbar'

interface Props {
	title: string
	description?: string
}

const { title, description } = Astro.props
---

<RootLayout title={title} description={description}>
	<main class="relative min-h-screen">
		<Navbar client:load />

		<slot />
	</main>
</RootLayout>
